        "costo_fisso_giornaliero": cfg.costo_fisso_giornaliero,
        "numero_operatori": cfg.numero_operatori,
        "prodotti": {k: asdict(v) for k, v in cfg.prodotti_configurati.items()},
    }
    with open(percorso, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)


def carica_configurazione(percorso: str) -> ConfigurazioneProcesso:
    with open(percorso, "r", encoding="utf-8") as f:
        dati = json.load(f)
    cfg = ConfigurazioneProcesso()
    cfg.orario_lavoro_giornaliero_ore = dati.get("orario_lavoro_giornaliero_ore", 8.0)
    cfg.giorni_lavorativi_settimana = dati.get("giorni_lavorativi_settimana", 6)
    cfg.capacita_giornaliera_complessiva_unita = dati.get("capacita_giornaliera_complessiva_unita")
    cfg.margine_temporale_percentuale = dati.get("margine_temporale_percentuale", 10.0)
    cfg.tasso_guasti_giornaliero = dati.get("tasso_guasti_giornaliero", 0.03)
    cfg.costo_fisso_giornaliero = dati.get("costo_fisso_giornaliero", 350.0)
    cfg.numero_operatori = dati.get("numero_operatori", 6)
    cfg.prodotti_configurati = {}
    for k, v in dati.get("prodotti", {}).items():
        cfg.prodotti_configurati[k] = Prodotto(**v)
    return cfg


