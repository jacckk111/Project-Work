    def _build_tab_region(self):
        self.notebook_outer = tk.Frame(self.inner_frame, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        self.notebook_outer.pack(fill="both", expand=True, padx=10, pady=(2, 6))
        self.nb = ttk.Notebook(self.notebook_outer, style="Officina.TNotebook")
        self.nb.pack(fill="both", expand=True)

        f_cfg = tk.Frame(self.nb, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        f_prod = tk.Frame(self.nb, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        f_sim = tk.Frame(self.nb, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        f_rep = tk.Frame(self.nb, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        self.nb.add(f_cfg, text="  ⚙  CONFIGURAZIONE  ")
        self.nb.add(f_prod, text="  🌱  PRODOTTI & QUANTITA  ")
        self.nb.add(f_sim, text="  ▶  SIMULAZIONE  ")
        self.nb.add(f_rep, text="  📊  REPORT & ANALISI  ")

        self._tab_configurazione(f_cfg)
        self._tab_prodotti(f_prod)
        self._tab_simulazione(f_sim)
        self._tab_report(f_rep)

    # --------------- Tab 1: Configurazione ---------------
    def _tab_configurazione(self, root_frm: tk.Frame):
        sx = tk.Frame(root_frm, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        sx.pack(side="left", fill="both", expand=True, padx=(6, 8), pady=10)
        dx = tk.Frame(root_frm, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        dx.pack(side="right", fill="both", expand=True, padx=(8, 6), pady=10)

        card_p = self._card(sx, "PARAMETRI DI PROCESSO", fill="both", expand=True, pady=(0, 8))
        griglia = tk.Frame(card_p, bg=card_p.cget("bg"))
        griglia.pack(fill="x", padx=14, pady=14)

        self.v_ore = tk.DoubleVar()
        self.v_gg = tk.IntVar()
        self.v_cap = tk.StringVar()
        self.v_marg = tk.DoubleVar()
        self.v_guasti = tk.DoubleVar()
        self.v_cf = tk.DoubleVar()
        self.v_op = tk.IntVar()

        righe = [
            ("Orario giornaliero (h):", self.v_ore),
            ("Giorni lavorativi / settimana:", self.v_gg),
            ("Capacità complessiva/giorno (0=illimitata):", self.v_cap),
            ("Margine temporale (%):", self.v_marg),
            ("Tasso guasti giornaliero (0..1):", self.v_guasti),
            ("Costo fisso giornaliero (€):", self.v_cf),
            ("N° operatori (scheduling parallelo):", self.v_op),
        ]
        for i, (lab, var) in enumerate(righe):
            self._etichetta(griglia, lab).grid(row=i, column=0, sticky="we", pady=5, padx=(0, 10))
            self._input(griglia, var, width=22).grid(row=i, column=1, sticky="we", pady=5)
        griglia.columnconfigure(1, weight=1)

        sep = tk.Frame(card_p, height=2, bg=TEMI_OFFICINA[self.tema_corrente]["separatore"])
        sep.pack(fill="x", padx=14)
        self._bottone_verde(card_p, "✅  APPLICA CONFIGURAZIONE", self._applica_config).pack(fill="x", padx=14, pady=12)

        card_pers = self._card(sx, "PERSISTENZA CONFIGURAZIONE", fill="x", expand=False, pady=(8, 0))
        self._bottone_secondario(card_pers, "💾  SALVA CONFIGURAZIONE JSON", self._salva_cfg).pack(fill="x", padx=14, pady=(14, 5))
        self._bottone_secondario(card_pers, "📂  CARICA CONFIGURAZIONE JSON", self._carica_cfg).pack(fill="x", padx=14, pady=5)
        self._bottone_secondario(card_pers, "↺  RIPRISTINA VALORI DI DEFAULT", self._ripristina_default).pack(fill="x", padx=14, pady=(5, 14))

        card_kpi = self._card(dx, "QUICK KPI  —  ULTIMI RISULTATI", fill="both", expand=True, pady=(0, 8))
        kpi_defs = [
            ("Regime:", "regime", "blue"),
            ("Tempo sequenziale:", "t_seq_g", "blue"),
            ("Tempo parallelo:", "t_par_g", "blue"),
            ("Speedup parallelismo:", "speedup", "green"),
            ("Costo complessivo:", "costo", "red"),
            ("Ricavo complessivo:", "ricavo", "green"),
            ("Profitto complessivo:", "profitto", "green"),
            ("Margine:", "margine_pct", "green"),
            ("Sequenza ottimale lotti:", "ordine", "blue"),
        ]
        kpi_body = tk.Frame(card_kpi, bg=card_kpi.cget("bg"))
        kpi_body.pack(fill="both", expand=True, padx=12, pady=12)
        for i, (lab, k, color) in enumerate(kpi_defs):
            self._etichetta(kpi_body, lab).grid(row=i, column=0, sticky="we", padx=(0, 10), pady=4)
            v = self._valore(kpi_body, "—")
            v.grid(row=i, column=1, sticky="we", pady=4)
            kpi_body.columnconfigure(1, weight=1)
            self.mappa_kpi[k] = v

        sep2 = tk.Frame(dx, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"], height=8)
        sep2.pack(fill="x")
        card_note = self._card(dx, "INFORMAZIONI DI SISTEMA", fill="x", expand=False, pady=(8, 0))
        nt = tk.Label(
            card_note,
            text="  Suggerimento: con 3 prodotti l'ottimizzazione sequenza\n"
                 "  calcola in modo esaustivo 6 permutazioni per minimizzare\n"
                 "  il makespan (tempo totale sequenziale) del lotto.",
            bg=TEMI_OFFICINA[self.tema_corrente]["note_sfondo"],
            fg=TEMI_OFFICINA[self.tema_corrente]["note_testo"],
            font=("Tahoma", 9),
            anchor="w",
            justify="left",
            padx=10, pady=10,
            relief="solid",
            bd=1,
            highlightthickness=1,
            highlightbackground=TEMI_OFFICINA[self.tema_corrente]["cornice_soft"],
        )
        nt.pack(fill="x", padx=12, pady=12)
        self.lista_note.append(nt)

