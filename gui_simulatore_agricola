    def _carica_default(self):
        self._aggiorna_campi_cfg()
        self._popola_tabella()

    def _aggiorna_campi_cfg(self):
        c = self.cfg
        self.v_ore.set(c.orario_lavoro_giornaliero_ore)
        self.v_gg.set(c.giorni_lavorativi_settimana)
        self.v_cap.set(c.capacita_giornaliera_complessiva_unita or 0)
        self.v_marg.set(c.margine_temporale_percentuale)
        self.v_guasti.set(c.tasso_guasti_giornaliero)
        self.v_cf.set(c.costo_fisso_giornaliero)
        self.v_op.set(c.numero_operatori)

    def _popola_tabella(self):
        for iid in self.tab.get_children():
            self.tab.delete(iid)
        t = TEMI_OFFICINA[self.tema_corrente]
        for i, (key, p) in enumerate(self.cfg.prodotti_configurati.items()):
            tag = "even" if i % 2 == 0 else "odd"
            self.tab.insert("", "end", iid=key, tags=(tag,), values=(
                key, p.nome, p.unita_misura, p.tempo_per_unita_ore, p.capacita_giornaliera,
                p.fase_preparazione_ore, p.fase_lavorazione_ore, p.resa_percentuale,
                p.tempo_unita_sigma, p.resa_sigma, p.costo_manodopera_ora, p.costo_macchinari_ora,
                p.prezzo_vendita_per_unita_output, self.quantita_correnti.get(key, ""),
            ))
        self.tab.tag_configure("odd", background=t["tree_alt"])
        self.tab.tag_configure("even", background=t["tree_sfondo"])

    def _applica_config(self):
        try:
            ore = float(self.v_ore.get())
            gg = int(self.v_gg.get())
            imposta_orario_lavoro(self.cfg, ore, gg)

            cap_raw = str(self.v_cap.get()).strip()
            cap = int(cap_raw) if cap_raw else 0
            imposta_capacita_complessiva(self.cfg, cap if cap > 0 else None)
            imposta_margine_temporale(self.cfg, float(self.v_marg.get()))

            guasti = float(self.v_guasti.get())
            if not (0 <= guasti < 1):
                raise ValueError("Tasso guasti in [0, 1)")
            self.cfg.tasso_guasti_giornaliero = guasti
            self.cfg.costo_fisso_giornaliero = max(0.0, float(self.v_cf.get()))
            nop = int(self.v_op.get())
            if nop <= 0:
                raise ValueError("N° operatori non valido")
            self.cfg.numero_operatori = nop

            self._status("OK.  Configurazione generale applicata.")
            messagebox.showinfo("OK", "Configurazione applicata con successo.")
        except ValueError as e:
            messagebox.showerror("Errore di input", str(e))

    def _salva_cfg(self):
        p = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON", "*.json")], initialfile="configurazione_agricola.json")
        if p:
            try:
                salva_configurazione(self.cfg, p)
                self._status(f"CONFIGURAZIONE SALVATA →  {p}")
                messagebox.showinfo("OK", f"Configurazione salvata:\n{p}")
            except OSError as e:
                messagebox.showerror("Errore I/O", str(e))

    def _carica_cfg(self):
        p = filedialog.askopenfilename(filetypes=[("JSON", "*.json")])
        if p:
            try:
                self.cfg = carica_configurazione(p)
                self._aggiorna_campi_cfg()
                self._popola_tabella()
                self._status(f"CONFIGURAZIONE CARICATA ←  {p}")
                messagebox.showinfo("OK", "Configurazione caricata.")
            except (OSError, TypeError) as e:
                messagebox.showerror("Errore", str(e))

