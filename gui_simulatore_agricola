    def _raccogli_qta(self) -> dict | None:
        qta = {}
        for key in self.cfg.prodotti_configurati:
            vals = self.tab.item(key, "values")
            try:
                q = int(float(vals[-1])) if str(vals[-1]).strip() else 0
            except (ValueError, TypeError):
                q = 0
            if q <= 0:
                messagebox.showwarning("Quantità mancante",
                                       f"Imposta una quantità > 0 per {self.cfg.prodotti_configurati[key].nome}")
                return None
            qta[key] = q
        self.quantita_correnti = qta
        return qta

    def _esegui(self):
        qta = self._raccogli_qta()
        if qta is None:
            return
        s_raw = str(self.v_seed_run.get()).strip()
        seed = int(s_raw) if s_raw.lstrip("-").isdigit() else None

        mc_it = int(self.v_it.get()) if self.v_mc.get() else 0
        if mc_it < 0:
            messagebox.showerror("Errore", "Iterazioni MC non valide.")
            return

        self._status("CALCOLO IN CORSO... attendere.")
        self.root.update_idletasks()

        try:
            rep = simulazione_completa(self.cfg, qta, seed=seed, mc_iterazioni=mc_it)
        except Exception as e:
            messagebox.showerror("Errore motore", str(e))
            self._status("ERRORE nella simulazione.")
            return

        self.report_corrente = rep
        out = genera_report_produzione(rep)
        self.txt_out.delete("1.0", "end")
        self.txt_out.insert("end", out)
        self._aggiorna_kpi(rep)
        self._aggiorna_report(rep)
        self._aggiorna_gantt(rep)
        self._status(
            f"SIMULAZIONE COMPLETATA: {rep.regime.upper()}"
            + (f" ({rep.monte_carlo_iterazioni} iterazioni MC).  " if rep.monte_carlo_iterazioni else ".  ")
            + f"PROFITTO = € {rep.profitto_complessivo}"
        )

    def _aggiorna_kpi(self, r: ReportSimulazione):
        speedup = 0.0
        if r.tempo_totale_giorni_parallelo > 0:
            speedup = r.tempo_totale_giorni_sequenziale / r.tempo_totale_giorni_parallelo
        mpct = (r.profitto_complessivo / r.ricavo_complessivo * 100) if r.ricavo_complessivo > 0 else 0

        vals = {
            "regime": r.regime.upper() + (f" ({r.monte_carlo_iterazioni})" if r.monte_carlo_iterazioni else ""),
            "t_seq_g": f"{r.tempo_totale_giorni_sequenziale} gg",
            "t_par_g": f"{r.tempo_totale_giorni_parallelo} gg",
            "speedup": f"{speedup:.2f}x",
            "costo": f"€ {r.costo_complessivo}",
            "ricavo": f"€ {r.ricavo_complessivo}",
            "profitto": f"€ {r.profitto_complessivo}",
            "margine_pct": f"{mpct:.2f} %",
            "ordine": "   →   ".join(r.ordine_lotti_ottimale or []),
        }
        t = TEMI_OFFICINA[self.tema_corrente]
        colori = {
            "regime": t["blu_kpi"], "t_seq_g": t["blu_kpi"], "t_par_g": t["blu_kpi"], "ordine": t["blu_kpi"],
            "speedup": t["verde_kpi"], "ricavo": t["verde_kpi"], "margine_pct": t["verde_kpi"],
            "costo": t["rosso_kpi"],
        }
        for k, text in vals.items():
            lab = self.mappa_kpi.get(k)
            if lab is None:
                continue
            lab.configure(text=text)
            if k == "profitto":
                col = t["rosso_kpi"] if r.profitto_complessivo < 0 else t["verde_kpi"]
            else:
                col = colori.get(k, t["blu_kpi"])
            lab.configure(fg=col)

    def _aggiorna_report(self, r: ReportSimulazione):
        for iid in self.tab_report.get_children():
            self.tab_report.delete(iid)
        t = TEMI_OFFICINA[self.tema_corrente]
        for idx, l in enumerate(r.lotti, 1):
            tag = "even" if idx % 2 == 0 else "odd"
            self.tab_report.insert("", "end", tags=(tag,), values=(
                idx, l.id_prodotto, l.quantita_input,
                l.tempo_preparazione_ore, l.tempo_raccolta_ore, l.tempo_lavorazione_ore, l.tempo_guasti_ore,
                l.tempo_totale_ore, l.tempo_totale_giorni_lavorativi, l.resa_effettiva_percentuale,
                l.output_finale_unita, l.costo_totale, l.ricavo_atteso, l.profitto_atteso,
            ))
        self.tab_report.tag_configure("odd", background=t["tree_alt"])
        self.tab_report.tag_configure("even", background=t["tree_sfondo"])

    def _aggiorna_gantt(self, r: ReportSimulazione):
        if not r.lotti:
            return
        fine_max = max((l.fine_giorno_relativo for l in r.lotti), default=1.0)
        scale = 74.0
        tot_units = max(int(round(fine_max * scale / max(fine_max, 0.001))), 2)
        righe = []
        righe.append("   LEGENDA:  [██] = fase attiva del lotto    ·    colonna sinistra = ID prodotto (inizio giorni  →  fine giorni)")
        righe.append("")
        mappa = {l.id_prodotto: l for l in r.lotti}
        ordine = r.ordine_lotti_ottimale or list(mappa.keys())
        for key in ordine:
            l = mappa[key]
            inizio = l.inizio_giorno_relativo
            fine = l.fine_giorno_relativo
            i_start = int(round((inizio / max(fine_max, 0.001)) * tot_units)) if fine_max > 0 else 0
            i_end = int(round((fine / max(fine_max, 0.001)) * tot_units)) if fine_max > 0 else tot_units
            i_end = max(i_start + 1, min(i_end, tot_units))
            barra = [" "] * tot_units
            for j in range(i_start, i_end):
                barra[j] = "█"
            righe.append(f"   {l.id_prodotto:<9}  [{''.join(barra)}]  {inizio:.2f} → {fine:.2f} gg")
        self.txt_gantt.delete("1.0", "end")
        self.txt_gantt.insert("end", "\n".join(righe))

    def _esporta_json(self):
        if self.report_corrente is None:
            messagebox.showwarning("Nessun report", "Esegui prima la simulazione.")
            return
        p = filedialog.asksaveasfilename(defaultextension=".json", filetypes=[("JSON", "*.json")], initialfile="report_produzione.json")
        if p:
            try:
                esporta_report_json(self.report_corrente, p)
                self._status(f"REPORT ESPORTATO →  {p}")
                messagebox.showinfo("OK", f"Report esportato:\n{p}")
            except OSError as e:
                messagebox.showerror("Errore I/O", str(e))

    def _status(self, m: str):
        self.status.set("  " + m)


