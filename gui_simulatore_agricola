        self._bottone_secondario(tb, "✏  MODIFICA PRODOTTO SELEZIONATO", self._modifica).pack(side="left", padx=(0, 18))
        self._etichetta(tb, "Seed:").pack(side="left", padx=(0, 8))
        self.v_seed = tk.StringVar(value="42")
        self._input(tb, self.v_seed, width=10).pack(side="left")

    # --------------- Tab 3: Simulazione ---------------
    def _tab_simulazione(self, root_frm: tk.Frame):
        sx_f = tk.Frame(root_frm, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        sx_f.pack(side="left", fill="y", expand=False, padx=(10, 8), pady=10)
        dx_f = tk.Frame(root_frm, bg=TEMI_OFFICINA[self.tema_corrente]["sfondo_applicativo"])
        dx_f.pack(side="right", fill="both", expand=True, padx=(8, 10), pady=10)

        sx_card = self._card(sx_f, "PANNELLO ESECUZIONE", fill="both", expand=True, pady=(0, 8))
        body = tk.Frame(sx_card, bg=sx_card.cget("bg"))
        body.pack(fill="y", expand=False, padx=12, pady=12)

        self.v_mc = tk.BooleanVar(value=True)
        self.v_it = tk.IntVar(value=500)
        self.v_seed_run = tk.StringVar(value="7")

        t = TEMI_OFFICINA[self.tema_corrente]
        mc_check = tk.Checkbutton(
            body,
            text="  ☑  ABILITA MONTE CARLO (stocasticità)",
            variable=self.v_mc,
            bg=t["card_sfondo"],
