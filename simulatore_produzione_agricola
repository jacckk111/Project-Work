@dataclass
class Distribuzione:
    valore_medio: float
    deviazione_standard: float = 0.0
    minimo: Optional[float] = None
    massimo: Optional[float] = None

    def campiona(self, rng: random.Random) -> float:
        if self.deviazione_standard <= 0:
            v = self.valore_medio
        else:
            v = rng.gauss(self.valore_medio, self.deviazione_standard)
        if self.minimo is not None:
            v = max(v, self.minimo)
        if self.massimo is not None:
            v = min(v, self.massimo)
        return v


