class SimulatoreAgricolturaGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("SIMULATORE PRODUZIONE AGRICOLA — GESTIONALE OFFICINA v3.1")
        self.root.geometry("1280x880")
        self.root.minsize(1120, 760)

        self.cartella = os.path.dirname(os.path.abspath(__file__))
        self.tema_corrente = "classico"

        self.cfg = configurazione_default()
        self.quantita_correnti: dict = {}
        self.report_corrente: ReportSimulazione | None = None

        self.lista_label_officina: list[tk.Label] = []
        self.lista_valore_officina: list[tk.Label] = []
        self.lista_input_officina: list[tk.Entry] = []
        self.lista_bottoni: list[tk.Button] = []
        self.lista_card: list[tk.Frame] = []
        self.lista_tree: list[tk.Widget] = []
        self.lista_text: list[tk.Text] = []
        self.lista_note: list[tk.Label] = []
        self.mappa_kpi: dict[str, tk.Label] = {}
        self.header_frame: tk.Frame | None = None
        self.status_frame: tk.Frame | None = None
        self.outer_frame: tk.Frame | None = None
        self.inner_frame: tk.Frame | None = None
        self.notebook_outer: tk.Frame | None = None

        self._layout_base()
        self._costruisci()
        self.applica_tema(self.tema_corrente)

    # --------------------- Layout base cornice nera ---------------------
    def _layout_base(self):
        t = TEMI_OFFICINA[self.tema_corrente]
        self.outer_frame = tk.Frame(self.root, bg=t["cornice_esterna"])
        self.outer_frame.pack(fill="both", expand=True, padx=t["cornice_spessore_px"], pady=t["cornice_spessore_px"])
        self.inner_frame = tk.Frame(self.outer_frame, bg=t["sfondo_applicativo"])
        self.inner_frame.pack(fill="both", expand=True, padx=3, pady=3)

    def _etichetta(self, parent, testo: str) -> tk.Label:
        t = TEMI_OFFICINA[self.tema_corrente]
        lab = tk.Label(
            parent,
            text=testo,
            bg=t["label_sfondo"],
            fg=t["label_testo"],
            font=FONT_LABEL,
            anchor="w",
            padx=t["label_padding_x"],
            pady=t["label_padding_y"],
            bd=0,
            highlightthickness=0,
        )
        self.lista_label_officina.append(lab)
        return lab

    def _valore(self, parent, testo_iniziale: str = "—") -> tk.Label:
        t = TEMI_OFFICINA[self.tema_corrente]
        lab = tk.Label(
            parent,
            text=testo_iniziale,
            bg=t["valore_sfondo"],
            fg=t["valore_testo"],
            font=FONT_VALORE,
            anchor="w",
            justify="left",
            padx=8,
            pady=4,
            bd=1,
            relief="solid",
            highlightbackground=t["valore_bordo"],
            highlightthickness=1,
            highlightcolor=t["valore_bordo"],
        )
        self.lista_valore_officina.append(lab)
        return lab

    def _input(self, parent, variabile: tk.Variable, width: int = 18) -> tk.Entry:
        t = TEMI_OFFICINA[self.tema_corrente]
        entry = tk.Entry(
            parent,
            textvariable=variabile,
            width=width,
            bg=t["input_sfondo"],
            fg=t["input_testo"],
            insertbackground=t["input_testo"],
            font=("Consolas", 10, "bold"),
            bd=0,
            relief="flat",
            highlightbackground=t["input_bordo"],
            highlightthickness=2,
            highlightcolor=t["input_bordo"],
            selectbackground=t["input_sfondo"],
            selectforeground=t["input_testo"],
            justify="left",
        )
        self.lista_input_officina.append(entry)
        return entry

    def _bottone_verde(self, parent, testo: str, cmd) -> tk.Button:
        t = TEMI_OFFICINA[self.tema_corrente]
        btn = tk.Button(
            parent,
            text=testo,
            command=cmd,
            bg=t["verde_primario"],
            fg=t["verde_testo"],
            activebackground=t["verde_hover"],
            activeforeground=t["verde_testo"],
            font=FONT_BOTTONE,
            bd=0,
            relief="flat",
            padx=12,
            pady=7,
            cursor="hand2",
            highlightthickness=2,
            highlightbackground=t["cornice_soft"],
            highlightcolor=t["cornice_soft"],
        )
        self.lista_bottoni.append(btn)
        return btn

    def _bottone_secondario(self, parent, testo: str, cmd) -> tk.Button:
        t = TEMI_OFFICINA[self.tema_corrente]
        btn = tk.Button(
            parent,
            text=testo,
            command=cmd,
            bg=t["pulsante_secondario_sfondo"],
            fg=t["pulsante_secondario_testo"],
            activebackground=t["card_sfondo"],
            activeforeground=t["pulsante_secondario_testo"],
            font=FONT_BOTTONE,
            bd=0,
            relief="flat",
            padx=10,
            pady=6,
            cursor="hand2",
            highlightthickness=2,
            highlightbackground=t["pulsante_secondario_bordo"],
            highlightcolor=t["pulsante_secondario_bordo"],
        )
        self.lista_bottoni.append(btn)
        return btn

    def _card(self, parent, titolo: str = "", fill: str = "both", expand: bool = True, side: str = "top", padx=0, pady=0) -> tk.Frame:
        t = TEMI_OFFICINA[self.tema_corrente]
        outer = tk.Frame(parent, bg=t["cornice_soft"], bd=0, highlightthickness=1, highlightbackground=t["cornice_soft"])
        outer.pack(fill=fill, expand=expand, side=side, padx=padx, pady=pady)
        inner = tk.Frame(outer, bg=t["card_sfondo"], bd=0, highlightthickness=1, highlightbackground=t["card_bordo"])
        inner.pack(fill="both", expand=True, padx=t["card_spessore_bordo"], pady=t["card_spessore_bordo"])
        if titolo:
            top = tk.Frame(inner, bg=t["barra_titolo"], height=28)
            top.pack(fill="x", side="top")
            tk.Label(
                top, text="  " + titolo,
                bg=t["barra_titolo"], fg="#ffffff",
                font=FONT_HEADING, anchor="w",
                padx=6, pady=4,
            ).pack(fill="x")
        self.lista_card.append(inner)
        self.lista_card.append(outer)
        return inner

